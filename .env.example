# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env de verdad a GitHub (ya esta en .gitignore).

# Token de acceso que te da Meta for Developers (WhatsApp > API Setup).
# Al principio es "temporal" y dura 24hs, despues generas uno permanente
# con un System User (lo explica el README).
WHATSAPP_TOKEN=

# El "Phone number ID" que te muestra Meta for Developers en la seccion
# WhatsApp > API Setup (NO es el numero de telefono en si, es un ID interno).
PHONE_NUMBER_ID=

# Un texto secreto que inventas VOS. Lo usa Meta para confirmar que el
# webhook es tuyo cuando lo configures. Puede ser cualquier palabra,
# por ejemplo: applica-verify-2026
VERIFY_TOKEN=

# Puerto local donde corre el servidor (Render lo pisa automaticamente
# con su propia variable PORT, esto es solo para correrlo en tu compu).
PORT=3000
